# URL of the Express server (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# BetterAuth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# MongoDB: use the SAME database as the server
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mentorlagbe

# JWT: MUST be exactly the same value as JWT_SECRET in server/.env
JWT_SECRET=replace-with-a-long-random-string

# ImgBB (https://api.imgbb.com/). Used only on the server side (/api/upload)
IMGBB_API_KEY=your-imgbb-api-key

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret